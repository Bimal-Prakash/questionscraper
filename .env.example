# Copy to .env and adjust. Every value below is optional - these are defaults.

# ---------------------------------------------------------------- app
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----------------------------------------------------------- database
# SQLite (default) is fine locally. Every deployed environment needs Postgres:
# free hosts wipe the disk on each deploy.
# Paste a provider URL exactly as given - the "postgres://" scheme is rewritten
# for psycopg at startup and ?sslmode=require is passed straight through.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=sqlite:///./data/questions.db

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000
# Leave blank in dev. In production set a long random string; starting or
# stopping the extractor, fetching a problem and deleting questions then
# require header: X-Admin-Token: <value>
ADMIN_TOKEN=
# Comma separated. Must list your real frontend origin in production.
# Scheme included, no trailing slash: https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Optional regex for frontends on rotating hostnames (preview/branch deploys).
# Example: https://.*\.my-app\.vercel\.app
CORS_ORIGIN_REGEX=
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ---------------------------------------------------------- extractor
# Polite delay between problem fetches, in seconds.
EXTRACT_DELAY_SECONDS=0.8
# Start pulling as soon as the API boots. Keep false on a free host that sleeps
# after 15 idle minutes - GitHub Actions runs the scheduled harvest instead.
EXTRACT_ON_STARTUP=false
